# Optional TMDB API key.
# Create an account and API key from https://www.themoviedb.org/settings/api
# Never commit a real key.
MOVIE_API_KEY=
MOVIE_API_BASE_URL=https://api.themoviedb.org/3
MOVIE_API_TIMEOUT=10000

# Optional no-key provider used automatically when TMDB_API_KEY is empty.
TVMAZE_API_BASE_URL=https://api.tvmaze.com

# Backward-compatible alias also supported by the webpack config:
TMDB_API_KEY=
